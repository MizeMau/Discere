<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Discere.MainPage"
             Title="MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <HorizontalStackLayout>
                <Label Padding="0,0,5,0">Card</Label>
                <Label x:Name="LabelCardNumber">x</Label>
                <Label>/</Label>
                <Label x:Name="LabelCardCount">y</Label>
                <Label Padding="5,0">·</Label>
                <Label>Difficulty:</Label>
                <Label x:Name="LabelDifficulty">Medium</Label>
            </HorizontalStackLayout>

            <Label x:Name="LabelQuestion">Explain what a primary key is in a relational database and why it matters.</Label>

            <Editor x:Name="EditorUserAnswer" Placeholder="Answer here" AutoSize="TextChanges" />

            <Button x:Name="BtnSubmit" 
                    Clicked="OnSubmitClicked"
                    HorizontalOptions="End" 
                    Text="Submit" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
